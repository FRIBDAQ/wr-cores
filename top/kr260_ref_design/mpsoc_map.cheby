memory-map:
  bus: axi4-lite-32
  name: mpsoc_map
  description: Memmap from mpsoc
  children:
  - submap:
     name: wrpc
     interface: wb-32-be
     size: 4k
     address: 0x0000
     x-hdl:
       busgroup: True
  - reg:
      name: ctrl
      comment: control register
      address: 0x1000
      width: 32
      access: rw
      children:
      - field:
          name: led1
          range: 0
      - field:
          name: led2
          range: 1
      - field:
          name: gth_rst
          range: 2
  - reg:
      name: status
      comment: status register
      width: 32
      access: ro
  - reg:
      name: const_a
      comment: constant
      width: 32
      access: ro
      preset: 0x00112233
      x-hdl:
        type: const
  - reg:
      name: txpi
      width: 32
      access: rw
      children:
      - field:
         name: en
         range: 0
      - field:
         name: ovrden
         range: 1
      - field:
         name: sel
         range: 2
      - field:
         name: pd
         range: 3
      - field:
         name: stepsize
         range: 12-8
  - submap:
      name: common_drp
      comment: access to gthe4 common DRP
      filename: drp_map.cheby
  - submap:
      name: gth_drp
      comment: access to wr gthe4 channel DRP
      filename: drp_map.cheby
  - submap:
      name: helper_drp
      comment: access to helper gthe4 channel DRP
      filename: drp_map.cheby
